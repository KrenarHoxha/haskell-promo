-- (a)
roundA1 :: Integer
roundA1 = round 6.7

roundA2 :: Integer
roundA2 = round 2.1

roundA3 :: Bool
roundA3 = (round pi :: Integer) == (round (exp 1) :: Integer)


-- (b)
roundToNearestTenth :: Double -> Double
roundToNearestTenth x =
  fromIntegral (round (x * 10)) / 10

roundToNearestNth :: Int -> Double -> Double
roundToNearestNth n x =
  fromIntegral (round (x * factor)) / factor
  where
    factor = 10 ^ n


-- (c) Pointfree-Versionen

roundToNearestTenthPF :: Double -> Double
roundToNearestTenthPF =
  (/ 10) . fromIntegral . round . (* 10)

roundToNearestNthPF :: Int -> Double -> Double
roundToNearestNthPF n =
  (/ factor) . fromIntegral . round . (* factor)
  where
    factor = 10 ^ n