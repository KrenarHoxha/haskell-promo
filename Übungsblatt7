--------------------------------------------------
-- Aufgabe 1: Funktionen höherer Ordnung
--------------------------------------------------

-- (a)
elem' :: Eq a => a -> [a] -> Bool
elem' x = foldr (\y acc -> y == x || acc) False


-- (b)
all' :: (a -> Bool) -> [a] -> Bool
all' p = foldr (\x acc -> p x && acc) True


-- (c)
reverse' :: [a] -> [a]
reverse' = foldl (flip (:)) []


-- (d)
takeWhile' :: (a -> Bool) -> [a] -> [a]
takeWhile' p = foldr (\x acc -> if p x then x : acc else []) []


