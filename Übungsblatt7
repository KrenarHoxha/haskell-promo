--------------------------------------------------
-- Aufgabe 3: Lösen von Problemen
--------------------------------------------------

-- (a)
sumOddSquares :: Integer
sumOddSquares = sum $ takeWhile (< 10000) $ filter odd $ map (^ 2) [1..]


-- (b)
chain :: Integral a => a -> [a]
chain 1 = [1]
chain n
  | even n = n : chain (n `div` 2)
  | odd n  = n : chain (n * 3 + 1)

longChainsOver15 :: Int
longChainsOver15 = length $ filter ((> 15) . length) $ map chain [1..100]


